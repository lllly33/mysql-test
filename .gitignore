# ============================================================================
# MySQL 8.0.34 源码 Git 忽略规则
# ============================================================================

# ============================================================================
# 编译产物
# ============================================================================
build/
build_*/
*.o
*.a
*.so
*.so.*
*.dylib
*.la
*.lo
*.lai
*.slo
*.dll
*.exe
*.out
*.app

# CMake 构建目录和缓存
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CPackConfig.cmake
CPackSourceConfig.cmake
CTestTestfile.cmake
DartConfiguration.tcl
install_manifest.txt
Makefile
*.cmake
!CMakeLists.txt
!cmake/*.cmake
!configure.cmake
!config.h.cmake

# 编译中间文件
*.dep
*.obj
*.pch
*.pdb
*.ilk
*.exp
*.lib

# ============================================================================
# MySQL 运行时文件
# ============================================================================
# 数据目录
data/
data_*/
**/data/
**/data_*/

# Socket 文件
*.sock
*.pid

# 日志文件
*.log
*.err
error.log
mysql.err
*.out

# 临时文件
*.tmp
*.temp
*.swp
*~

# ============================================================================
# 测试框架产物
# ============================================================================
# 测试结果输出
tests/out/
tests/out/runs/
tests/out/reports/

# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.pyc
.pytest_cache/

# ============================================================================
# 敏感配置文件（包含密码等）
# ============================================================================
# 实际的配置文件（不提交，只提交模板）
tests/config.yaml
config.yaml

# 备份文件
*.backup
*.bak
*.old

# ============================================================================
# IDE 和编辑器
# ============================================================================
# VS Code
.vscode/
*.code-workspace

# IntelliJ / CLion
.idea/
*.iml
*.iws
*.ipr
cmake-build-*/

# Vim
*.swp
*.swo
*~
.*.swp
.*.swo

# Emacs
*~
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# Eclipse
.project
.cproject
.settings/

# ============================================================================
# 操作系统
# ============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# Linux
.directory
.Trash-*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ============================================================================
# 其他
# ============================================================================
# 压缩文件
*.tar
*.tar.gz
*.tgz
*.zip
*.rar
*.7z

# Core dumps
core
core.*
vgcore.*

# 性能分析
*.prof
*.perf
perf.data*

# ============================================================================
# 保留的重要文件（确保不被忽略）
# ============================================================================
# 重要：模板配置文件需要提交
!tests/config.yaml.example
!config.yaml.example

# 重要：文档需要提交
!**/*.md
!**/*.txt
!README
!LICENSE
!INSTALL

# 重要：SQL 脚本需要提交
!**/*.sql

# 重要：Python 测试脚本需要提交
!tests/*.py
!tests/**/*.py

# 重要：Bash 脚本需要提交
!**/*.sh
